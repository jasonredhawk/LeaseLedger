<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>leaseledger-web</UserSecretsId>
    <BlazorDisableThrowNavigationException>false</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Stripe.net" Version="52.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LeaseLedger.Infrastructure\LeaseLedger.Infrastructure.csproj" />
    <ProjectReference Include="..\LeaseLedger.Shared\LeaseLedger.Shared.csproj" />
  </ItemGroup>

</Project>
