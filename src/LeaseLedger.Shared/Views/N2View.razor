@inject ILeaseLedgerClient Client

<PageTitle>@OfficialForms.Find(NoticeKind.N2).Label · LeaseLedger</PageTitle>

<FormWithPdf Kind="NoticeKind.N2">

<header class="page-head">
    <h1>@OfficialForms.Find(NoticeKind.N2).Label</h1>
    <p>For a unit exempt from the guideline. @NoticeCopy.Disclaimer</p>
</header>

@if (!string.IsNullOrEmpty(error))
{
    <p class="banner" role="alert">@error</p>
}

<section class="panel">
    <EditForm Model="form" OnValidSubmit="Preview">
        <div class="fields">
            <label>Notice date <InputDate @bind-Value="form.NoticeDate" /></label>
            <label>Proposed effective date <InputDate @bind-Value="form.ProposedEffectiveDate" /></label>
            <label>New rent <InputNumber @bind-Value="form.ProposedRent" /></label>
        </div>
        <button type="submit">Calculate</button>
    </EditForm>
</section>

@if (result is not null)
{
    <section class="panel">
        <p>Current rent @TextFormat.Money(result.CurrentRent)</p>
        @if (result.EarliestEffectiveDate is DateOnly earliest)
        {
            <p>Earliest effective date <strong>@TextFormat.Date(earliest)</strong></p>
        }
        <p>@result.Explanation</p>
        @if (result.IsValid)
        {
            <p class="banner ok">
                Increase @TextFormat.Money(result.IncreaseAmount ?? 0)
                (@result.IncreasePercent?.ToString("0.##")%).
                New rent <strong>@TextFormat.Money(result.NewRent ?? 0)</strong>.
            </p>
            <button type="button" @onclick="Save">Keep this worksheet</button>
        }
        else
        {
            <ul class="errors">
                @foreach (var message in result.Errors)
                {
                    <li>@message</li>
                }
            </ul>
        }
        <p class="muted">@result.Disclaimer</p>
        @if (saved is not null)
        {
            <p class="banner ok">@saved</p>
        }
    </section>
}

</FormWithPdf>

@code {
    [Parameter] public Guid TenancyId { get; set; }

    private readonly N2PreviewRequest form = new()
    {
        NoticeDate = DateOnly.FromDateTime(DateTime.Today),
        ProposedEffectiveDate = DateOnly.FromDateTime(DateTime.Today).AddMonths(4)
    };
    private N2PreviewDto? result;
    private string? error;
    private string? saved;

    private async Task Preview()
    {
        error = null;
        saved = null;
        try
        {
            result = await Client.PreviewN2Async(TenancyId, form);
        }
        catch (LeaseLedgerException exception)
        {
            error = exception.Message;
        }
    }

    private async Task Save()
    {
        error = null;
        try
        {
            await Client.SaveN2Async(TenancyId, form);
            saved = "Worksheet saved on this tenancy. It is still not an official form.";
        }
        catch (LeaseLedgerException exception)
        {
            error = exception.Message;
        }
    }
}
